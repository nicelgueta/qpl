# Render qpl scripts with q syntax highlighting in the GitHub UI, and make sure
# they still count toward the repo language stats even though they live in
# examples/ (which GitHub's Linguist auto-treats as vendored).
*.qpl linguist-language=SupportedLanguage linguist-vendored
*.qpl linguist-language=q
*.qpl linguist-detectable=true
*.qpl linguist-vendored=false
*.qpl linguist-generated=false

# Sample data for the examples: never count it in language stats
examples/data/*.parquet linguist-generated=true
