{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run qpl Extension",
      "type": "extensionHost",
      "request": "launch",
      "preLaunchTask": "npm: compile",
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/../../examples"
      ]
    }
  ]
}
