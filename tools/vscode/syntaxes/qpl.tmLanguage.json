{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "qpl",
  "scopeName": "source.qpl",
  "patterns": [
    { "include": "#comment" },
    { "include": "#repl" },
    { "include": "#string" },
    { "include": "#symbol" },
    { "include": "#number" },
    { "include": "#assignment" },
    { "include": "#builtin" },
    { "include": "#namespace" },
    { "include": "#keyword" },
    { "include": "#cast" },
    { "include": "#aggregate" },
    { "include": "#index" },
    { "include": "#operator" },
    { "include": "#identifier" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.slash.qpl",
      "match": "/.*$"
    },
    "repl": {
      "match": "^\\s*(\\\\(?:[d1li]|port)|log)\\b",
      "captures": {
        "1": { "name": "keyword.other.repl.qpl" }
      }
    },
    "string": {
      "name": "string.quoted.double.qpl",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.qpl",
          "match": "\\\\[ntr\"\\\\]"
        }
      ]
    },
    "symbol": {
      "name": "entity.name.type.symbol.qpl",
      "match": "(`[A-Za-z0-9_.\\/-]*)+"
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.float.qpl",
          "match": "\\b\\d+\\.\\d*"
        },
        {
          "name": "constant.numeric.bool.qpl",
          "match": "\\b[01]+b\\b"
        },
        {
          "name": "constant.numeric.integer.qpl",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "assignment": {
      "match": "^\\s*([A-Za-z_]\\w*)\\s*(:)(?!=)",
      "captures": {
        "1": { "name": "variable.other.qpl" },
        "2": { "name": "keyword.operator.assignment.qpl" }
      }
    },
    "builtin": {
      "comment": "`.qpl.*` namespaced builtin functions (e.g. `.qpl.cfg`) — coloured like load / sink / cols",
      "name": "keyword.other.qpl",
      "match": "\\.qpl\\.[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*"
    },
    "namespace": {
      "comment": "a user namespace reference (e.g. `.utils.helper`, from `\\i \"utils.qpl\"`) — any other dotted name, coloured like a plain identifier",
      "name": "variable.other.qpl",
      "match": "\\.[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)+"
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.control.qpl",
          "match": "\\b(select|by|from|where|over|order|asc|desc|distinct|limit|drop|update|delete|lj|ij|rj|like|dispatch)\\b"
        },
        {
          "name": "keyword.other.qpl",
          "match": "\\b(load|sink|cols|lazy|collect|til|zip|hopen|await|async)\\b"
        }
      ]
    },
    "cast": {
      "match": "\\b(f64|float|f32|i64|int|i32|i16|i8|u64|u32|u16|u8|bool|str|string)(\\$)",
      "captures": {
        "1": { "name": "support.type.cast.qpl" },
        "2": { "name": "support.function.operator.qpl" }
      }
    },
    "aggregate": {
      "name": "support.function.aggregate.qpl",
      "match": "\\b(sum|avg|mean|min|max|count|first|last|std|dev|var|med|median|mode|modal|skew|kurt|kurtosis|any|all|prod|product|argmin|argmax|nnull|null_count|cumsum|cummax|cummin|cumprod|cumcount|ffill|bfill|abs|neg|not|string|n_unique|round|quantile|pctl|shift|lag|lead|diff|pctchange|rolling|rn|rank|drank)\\b"
    },
    "index": {
      "name": "variable.language.index.qpl",
      "match": "\\bi\\b"
    },
    "identifier": {
      "name": "variable.other.qpl",
      "match": "\\b[A-Za-z_]\\w*\\b"
    },
    "operator": {
      "patterns": [
        {
          "comment": "multi-char comparisons — matched before bare `!` so `!=` wins",
          "name": "keyword.operator.qpl",
          "match": "<>|!=|<=|>="
        },
        {
          "comment": "q-style operator functions — coloured like sum / avg",
          "name": "support.function.operator.qpl",
          "match": "::|[?$!#]"
        },
        {
          "name": "keyword.operator.qpl",
          "match": "[-+*%=<>&|]"
        }
      ]
    }
  }
}
