{
  "name": "qpl",
  "displayName": "qpl — Quick Polars Language",
  "description": "Syntax highlighting and an interactive REPL for the qpl language.",
  "version": "0.3.1",
  "publisher": "nicelgueta",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nicelgueta/qpl"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:qpl"
  ],
  "contributes": {
    "languages": [
      {
        "id": "qpl",
        "aliases": [
          "qpl",
          "QPL"
        ],
        "extensions": [
          ".qpl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "qpl",
        "scopeName": "source.qpl",
        "path": "./syntaxes/qpl.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "qpl",
        "path": "./snippets/qpl.json"
      }
    ],
    "commands": [
      {
        "command": "qpl.runFileOrSelection",
        "title": "Run File or Selection in REPL",
        "category": "qpl"
      },
      {
        "command": "qpl.startRepl",
        "title": "Start REPL",
        "category": "qpl"
      },
      {
        "command": "qpl.restartRepl",
        "title": "Restart REPL",
        "category": "qpl"
      }
    ],
    "keybindings": [
      {
        "command": "qpl.runFileOrSelection",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == qpl"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "qpl.runFileOrSelection",
          "when": "editorLangId == qpl",
          "group": "qpl@1"
        }
      ]
    },
    "configurationDefaults": {
      "[qpl]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
      }
    },
    "configuration": {
      "title": "qpl",
      "properties": {
        "qpl.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `qpl` executable. When empty, the extension auto-detects: `qpl` on `PATH`, then `target/release/qpl` or `target/debug/qpl` in the workspace, then `cargo run` if a qpl `Cargo.toml` is found."
        },
        "qpl.loadDemo": {
          "type": "boolean",
          "default": false,
          "description": "Start the REPL with --load-demo (preloads the demo `trades` / `quotes` tables)."
        },
        "qpl.demoTables": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "trades",
            "quotes"
          ],
          "description": "Table names offered by completion in addition to those found in the open document (matches --load-demo's tables by default)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.4.0"
  }
}
