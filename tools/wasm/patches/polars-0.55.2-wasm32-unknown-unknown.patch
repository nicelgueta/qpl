diff --git a/crates/polars-core/Cargo.toml b/crates/polars-core/Cargo.toml
index 54b39b7c3a..9bb8988e89 100644
--- a/crates/polars-core/Cargo.toml
+++ b/crates/polars-core/Cargo.toml
@@ -44,12 +44,21 @@ schemars = { workspace = true, optional = true, features = ["uuid1"] }
 serde = { workspace = true, optional = true }
 serde_json = { workspace = true, optional = true }
 strum_macros = { workspace = true }
-tokio = { workspace = true, features = ["fs", "net", "rt-multi-thread", "time", "sync"] }
 uuid = { workspace = true }
 xxhash-rust = { workspace = true }
 
+[target.'cfg(not(target_family = "wasm"))'.dependencies]
+# Not used by polars-core itself: this exists so that Cargo feature unification
+# hands `polars-io` (which declares `tokio` with no features of its own) the
+# `fs`/`net`/`sync`/`time` it needs. tokio rejects `fs` and `net` on wasm, and
+# `net` pulls `mio`, which has no wasm32-unknown-unknown backend at all.
+tokio = { workspace = true, features = ["fs", "net", "rt-multi-thread", "time", "sync"] }
+
 [target.'cfg(target_family = "wasm")'.dependencies]
 uuid = { workspace = true, features = ["js"] }
+# wasm gets only the subset tokio supports there; the `tokio::fs` call sites in
+# polars-io are `cfg`-ed to `std::fs` to match.
+tokio = { workspace = true, features = ["sync", "time"] }
 
 [dev-dependencies]
 bincode = { workspace = true }
