/ ─────────────────────────────────────────────────────────────────────────────
/ A quick tour of the core query language.
/
/ Run from the repo root:
/   cargo run -- examples/basics.qpl
/ ─────────────────────────────────────────────────────────────────────────────

/ load is eager - so creates a table directly
trades: load "examples/data/trades.parquet"

log "projection + aliasing"
select sym, px: price, qty: size from trades

log "scalar variable, reused in a later query"
thr: 150
select from trades where size > thr

log "casts fold in a scalar context too - `int$` truncates, strings are parsed"
thr: int$149.5 + 1
select from trades where size > thr

log "where with multiple successive filters (comma = AND)"
select sym, price from trades where size > 100, price < 400

log "combine predicates with & (and) / | (or); parenthesise, q has no precedence"
select from trades where (size > 400) | (price < 141)

log "like: q-style glob match — * any sequence, ? any single char, [..] a class"
select sym from trades where sym like "AA*"
select sym from trades where sym like "[AM]*"
select from trades where not sym like "AAPL"

log "group-by aggregation"
select traded: sum size, apx: avg price by sym, side from trades

log "conditional column via ?[...] (vectorised conditional, q-style)"
select sym, tier: ?[price > 400; `high; price > 180; `mid; `low] from trades

log "order + type cast (order by columns that survive the projection)"
select sym, sz: f64$size from trades order sym asc, sz desc

log "from takes any table expression, not just a table name — here, a nested select"
select sym from select sym, price from trades where price > 150

log "table operators compose the same way — cols on a nested select"
cols select sym, price from trades where size > 100
