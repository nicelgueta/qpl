/ ─────────────────────────────────────────────────────────────────────────────
/ Window functions: `<expr> over `key [order `k asc `k2 desc]`.
/
/ Run from the repo root:
/   cargo run -- examples/window_functions.qpl
/ ─────────────────────────────────────────────────────────────────────────────

trades: load `examples/data/trades.parquet

log "partition aggregate broadcast back to every row (SQL: max(price) OVER (PARTITION BY sym))"
select sym, price, top: max price over `sym from trades

log "`over` binds tighter than arithmetic, so no parens needed here"
select sym, price, off_top: max price over `sym - price from trades

/ ranking verbs need an `order` sub-clause (space-separated `col asc|desc pairs)
/   rn    = row_number()  — strict 1..n
/   rank  = rank()        — ties share the low rank, then a gap
/   drank = dense_rank()  — ties share a rank, no gap
log "ranking verbs: rn (row_number), rank (ties share low rank + gap), drank (dense_rank, no gap)"
select sym, side, price,
    rn:    rn    over `sym order `price asc,
    rnk:   rank  over `sym order `side  asc,
    drnk:  drank over `sym order `side  asc
    from trades

log "multi-key order with independent directions: side ascending, then price descending"
select sym, side, price, seat: rn over `sym order `side asc `price desc from trades

/ ── ordered aggregates ───────────────────────────────────────────────────────
/ any aggregate may take an `order` sub-clause: the partition is sorted before
/ the aggregate runs (one direction for all keys). Handy for cumulatives and the
/ row-relative dyadic verbs. (ordering by `price` here just for a stable
/ sequence — real data would order by a timestamp.)

/ running total, plus previous row and the change from it
/   cumsum <col>        — running total
/   <n> shift <col>     — value n rows earlier   (alias: `lag`)
/   <n> diff  <col>     — difference from n rows back
log "running total (cumsum), previous row (shift/lag), and the change from it (diff)"
select sym, price,
    run:  cumsum price over `sym order `price asc,
    prev: 1 shift price over `sym order `price asc,
    chg:  1 diff  price over `sym order `price asc
    from trades

/ ── rolling windows ─────────────────────────────────────────────────────────
/ a trailing `rolling <n>` turns the aggregate into a fixed n-row moving window
/ (sum / avg / min / max / std / var / median). The first n-1 rows of each
/ partition are null — the window isn't full yet.
log "a trailing `rolling <n>` turns the aggregate into a fixed n-row moving window"
select sym, price,
    ma3: avg price over `sym order `price asc rolling 2,
    mx3: max price over `sym order `price asc rolling 2
    from trades
