/ ─────────────────────────────────────────────────────────────────────────────
/ Functions: `name: {[a,b] stmt; stmt; last-expr}` (q-style lambdas).
/
/ - the parameter list `[a,b]` is optional (`{[] ..}` / `{ ..}` are niladic)
/ - statements are `;`-separated; the final one is an expression — its value
/   is the return. Earlier statements may bind locals (scoped to the call).
/ - written across several lines instead, `;` is optional: one line at the
/   body's own indent = one statement (like a script), and a further-indented
/   line continues the statement above it.
/ - call with brackets: `f[1;2]`, `f[]`, `f[`AAPL]`; or monadically `f 41`.
/ - functions are a named binding kind — they are not first-class values and
/   cannot appear inside a `select` projection.
/
/ Run from the repo root:
/   cargo run -- --load-demo examples/functions.qpl
/ ─────────────────────────────────────────────────────────────────────────────

log "a plain scalar function"
add: {[x,y] x+y}
add[2;3]

log "monadic call, two spellings"
inc: {[x] x+1}
inc 41
inc[41]

log "a local variable, scoped to the call (qpl evaluates right-to-left, so the parens matter)"
hypot2: {[a,b] s: (a*a) + (b*b); s}
hypot2[3;4]

log "conditional recursion - ?[cond;then;else] works in value context"
fac: {[n] ?[n<2; 1; n*fac[n-1]]}
fac[5]

log "a function that parameterises a query and returns a table"
bysym: {[s] select sym, price, size from trades where sym = s}
bysym[`AAPL]

log "... and one that reduces its result to a scalar"
avgpx: {[s] avg select price from trades where sym = s}
2 round avgpx[`MSFT]

log "a multi-line function: the README/DuckDB pipeline, parameterised and reusable"
log "join quotes onto trades, filter, size-band, aggregate by sym/side/band, sort"
log "one statement per line, no `;` needed - only the `by`/`from`/`order` lines"
log "are indented further, so they continue the `select` above them"
summarise: {[min_price]
    joined: select sym, side, price, size, bid, ask from trades `sym lj quotes `sym
    priced: select from joined where price > min_price
    banded: update band: `$?[size >= 300; `large; size >= 150; `mid; `small] from priced
    select tot: sum price * size, avg_spread: avg ask - bid, n: count price
        by sym, side, band
        from banded
        order tot desc
    }

summarise[0]                / every trade
summarise[150]               / only trades priced above 150

log "temporal parameters: the demo `trades`/`quotes` carry a `ts` timestamp column"
log "(one morning, 2024.03.15 - see `load_demo_tables` / examples/temporal.qpl)"

log "a function taking a timestamp literal, filtering with it"
after: {[t] select sym, price, ts from trades where ts > t}
after[2024.03.15D10:00:00.000]

log "two timestamp parameters define a time window"
between: {[lo,hi] select sym, price, ts from trades where ts >= lo, ts <= hi}
between[2024.03.15D09:30:00.000; 2024.03.15D09:45:05.000000000]

log "temporal arithmetic + a now-function composed inside a function body"
elapsed: {[t] .qpl.p - t}      / a `timespan` — however long ago `t` was
elapsed[2024.03.15D09:30:00.000000000]

log "a per-symbol lookup returning its latest trade"
latest: {[s] select lts: max ts from trades where sym = s}
latest[`AAPL]
